{
  "name": "localmind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private AI chat that runs in your browser: optional on-device WebGPU and CPU models plus a built-in rule engine.",
  "license": "MIT",
  "scripts": {
    "models:sync": "node scripts/sync-model-catalogue.mjs",
    "predev": "npm run models:sync",
    "dev": "vite",
    "prebuild": "npm run models:sync",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "evals": "vitest run tests/evals",
    "evals:model": "node scripts/model-eval.mjs",
    "evals:model:record": "node scripts/model-eval.mjs --record --update-baseline",
    "test:e2e": "playwright test",
    "test:e2e:preview": "node scripts/e2e-preview.mjs",
    "check:size": "node scripts/check-size.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mlc-ai/web-llm": "^0.2.89",
    "@wllama/wllama": "3.13.0",
    "dompurify": "3.4.18",
    "highlight.js": "11.12.0",
    "marked": "18.2.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
